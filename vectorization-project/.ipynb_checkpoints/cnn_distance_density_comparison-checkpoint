    "def draw_vectors(axis, image, vectors, title, colour):\n",
    "    axis.imshow(image, cmap='gray', vmin=0, vmax=1, interpolation='nearest')\n",
    "    for x0, y0, x1, y1 in vectors:\n",
    "        axis.plot([x0, x1], [y0, y1], color=colour, linewidth=1.6)\n",
    "    axis.set_title(title)\n",
    "    axis.set_xlim(-1, IMG_SIZE)\n",
    "    axis.set_ylim(IMG_SIZE, -1)\n",
    "    axis.set_aspect('equal')\n",
    "    axis.axis('off')\n",
    "\n",
    "\n",
    "def draw_sample_comparison(axes, sample_idx):\n",
    "    \"\"\"Draw the target and both CNN predictions into three supplied axes.\"\"\"\n",
    "    method_names = list(METHODS_TO_COMPARE)\n",
    "\n",
    "    draw_vectors(\n",
    "        axes[0],\n",
    "        test_images[sample_idx],\n",
    "        test_vectors[sample_idx],\n",
    "        f'Sample {sample_idx}: target\\n{len(test_vectors[sample_idx])} vectors',\n",
    "        'tab:blue',\n",
    "    )\n",
    "\n",
    "    for axis, method_name in zip(axes[1:], method_names):\n",
    "        method_info = METHODS_TO_COMPARE[method_name]\n",
    "        preprocess_name = method_info['preprocess_method']\n",
    "        display_image = decode_preprocessed_image(\n",
    "            preprocessed_test_datasets[preprocess_name][sample_idx]\n",
    "        )\n",
    "        pred_vectors = comparison_outputs[sample_idx][method_name]['vectors']\n",
    "        draw_vectors(\n",
    "            axis,\n",
    "            display_image,\n",
    "            pred_vectors,\n",
    "            f'{PREPROCESS_METHODS[preprocess_name][\"display_name\"]}\\n'\n",
    "            f'{len(pred_vectors)} predicted vectors',\n",
    "            'tab:orange',\n",
    "        )\n",
    "\n",
    "\n",
    "def save_visual_check(sample_idx):\n",
