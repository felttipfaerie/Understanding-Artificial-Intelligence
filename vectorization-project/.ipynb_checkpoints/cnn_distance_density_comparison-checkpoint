     "text": [
      "Preparing test input: Distance-to-stroke\n",
      "Preparing test input: Local density blur\n",
      "Saved: cnn_distance_density_15epoch_comparison_with_screen_outputs_results\\preprocessing_config.csv\n",
      "Saved: cnn_distance_density_15epoch_comparison_with_screen_outputs_results\\preprocessing_example.png\n"
     ]
    }
   ],
   "source": [
    "from scipy.ndimage import distance_transform_edt, uniform_filter\n",
    "\n",
    "PREPROCESS_METHODS = {\n",
    "    'distance_transform': {\n",
    "        'display_name': 'Distance-to-stroke',\n",
    "        'kind': 'distance_transform',\n",
    "        'threshold': 0.5,\n",
    "        'distance_decay_px': 4.0,\n",
    "    },\n",
    "    'local_density': {\n",
    "        'display_name': 'Local density blur',\n",
    "        'kind': 'local_density',\n",
    "        'threshold': 0.5,\n",
    "        'density_radius': 2,\n",
    "    },\n",
    "}\n",
    "\n",
    "TRAIN_PREPROCESS_METHODS = list(PREPROCESS_METHODS)\n",
    "\n",
    "\n",
    "def preprocess_raster_image(image, config):\n",
    "    \"\"\"Create one requested CNN input representation.\n",
    "\n",
    "    Input/output convention before uint8 storage:\n",
    "    - 0 = strong stroke/feature\n",
    "    - 1 = background/no feature\n",
    "    \"\"\"\n",
    "    threshold = float(config.get('threshold', 0.5))\n",
    "    stroke = np.asarray(image) <= threshold\n",
    "    kind = config['kind']\n",
    "\n",
    "    if kind == 'distance_transform':\n",
    "        decay = float(config.get('distance_decay_px', 4.0))\n",
    "        distance = distance_transform_edt(~stroke)\n",
    "        feature_strength = np.exp(-distance / max(decay, 1e-6))\n",
    "\n",
    "    elif kind == 'local_density':\n",
    "        radius = int(config.get('density_radius', 2))\n",
    "        size = 2 * radius + 1\n",
    "        feature_strength = uniform_filter(\n",
    "            stroke.astype(np.float32),\n",
    "            size=size,\n",
    "            mode='nearest',\n",
    "        )\n",
    "        max_value = float(feature_strength.max())\n",
    "        if max_value > 0:\n",
    "            feature_strength = feature_strength / max_value\n",
    "\n",
    "    else:\n",
    "        raise ValueError(f'Unsupported preprocessing kind: {kind}')\n",
    "\n",
    "    return np.clip(1.0 - feature_strength, 0.0, 1.0).astype(np.float32)\n",
    "\n",
    "\n",
    "def encode_preprocessed_image(image):\n",
    "    \"\"\"Store a 0..1 preprocessing image compactly as uint8.\"\"\"\n",
    "    return np.rint(np.clip(image, 0.0, 1.0) * 255.0).astype(np.uint8)\n",
    "\n",
    "\n",
    "def decode_preprocessed_image(image_uint8):\n",
    "    \"\"\"Convert compact preprocessing storage back to float32 in the range 0..1.\"\"\"\n",
    "    return np.asarray(image_uint8, dtype=np.float32) / 255.0\n",
    "\n",
    "\n",
    "def preprocess_raster_dataset(images, config):\n",
    "    \"\"\"Preprocess a dataset and return compact images plus aggregate statistics.\"\"\"\n",
    "    images = np.asarray(images)\n",
    "    processed = np.empty(images.shape, dtype=np.uint8)\n",
    "    raw_stroke_counts = []\n",
    "    processed_feature_counts = []\n",
    "    threshold = float(config.get('threshold', 0.5))\n",
    "\n",
    "    for idx, image in enumerate(images):\n",
    "        processed_float = preprocess_raster_image(image, config)\n",
    "        processed[idx] = encode_preprocessed_image(processed_float)\n",
    "        raw_stroke_counts.append(int((image <= threshold).sum()))\n",
    "        processed_feature_counts.append(int((processed_float <= 0.5).sum()))\n",
    "\n",
    "    stats = {\n",
    "        'mean_raw_stroke_pixels': float(np.mean(raw_stroke_counts)),\n",
    "        'mean_processed_feature_pixels': float(np.mean(processed_feature_counts)),\n",
    "    }\n",
    "    return processed, stats\n",
    "\n",
    "\n",
    "# Test representations are retained for evaluation and visual checks.\n",
    "# Training representations are created one method at a time later to keep memory use controlled.\n",
    "preprocessed_test_datasets = {}\n",
    "test_preprocess_stats = {}\n",
    "\n",
    "for preprocess_name, config in PREPROCESS_METHODS.items():\n",
    "    print(f'Preparing test input: {config[\"display_name\"]}')\n",
    "    test_encoded, stats = preprocess_raster_dataset(test_images, config)\n",
    "    preprocessed_test_datasets[preprocess_name] = test_encoded\n",
    "    test_preprocess_stats[preprocess_name] = stats\n",
    "\n",
    "preprocess_config_df = pd.DataFrame([\n",
    "    {'preprocess_method': name, **config}\n",
    "    for name, config in PREPROCESS_METHODS.items()\n",
    "])\n",
    "preprocess_config_path = OUTPUT_DIR / 'preprocessing_config.csv'\n",
    "preprocess_config_df.to_csv(preprocess_config_path, index=False)\n",
    "\n",
    "# Save one small preprocessing example rather than displaying a large notebook figure.\n",
    "fig, axes = plt.subplots(1, 3, figsize=(9, 3), dpi=140)\n",
    "axes[0].imshow(test_images[0], cmap='gray', vmin=0, vmax=1, interpolation='nearest')\n",
    "axes[0].set_title('Raw synthetic raster')\n",
    "axes[0].axis('off')\n",
    "\n",
    "for axis, preprocess_name in zip(axes[1:], TRAIN_PREPROCESS_METHODS):\n",
    "    image = decode_preprocessed_image(preprocessed_test_datasets[preprocess_name][0])\n",
    "    axis.imshow(image, cmap='gray', vmin=0, vmax=1, interpolation='nearest')\n",
    "    axis.set_title(PREPROCESS_METHODS[preprocess_name]['display_name'])\n",
    "    axis.axis('off')\n",
    "\n",
    "fig.tight_layout()\n",
    "preprocess_preview_path = OUTPUT_DIR / 'preprocessing_example.png'\n",
    "fig.savefig(preprocess_preview_path, bbox_inches='tight')\n",
    "plt.close(fig)\n",
    "\n",
    "print('Saved:', preprocess_config_path)\n",
    "print('Saved:', preprocess_preview_path)"
   ]
