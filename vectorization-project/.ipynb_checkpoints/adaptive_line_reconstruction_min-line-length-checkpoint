    "        filename = EXPORT_DIR / f\"sample_{idx}_original_vs_predicted.svg\"\n",
    "\n",
    "    scale = 6\n",
    "    W = IMG_SIZE * scale\n",
    "    H = IMG_SIZE * scale\n",
    "\n",
    "    svg = ET.Element(\n",
    "        \"svg\",\n",
    "        {\n",
    "            \"xmlns\": \"http://www.w3.org/2000/svg\",\n",
    "            \"width\": str(W),\n",
    "            \"height\": str(H),\n",
    "            \"viewBox\": f\"0 0 {IMG_SIZE} {IMG_SIZE}\",\n",
    "        },\n",
    "    )\n",
    "\n",
    "    ET.SubElement(svg, \"rect\", {\n",
    "        \"x\": \"0\", \"y\": \"0\",\n",
    "        \"width\": str(IMG_SIZE),\n",
    "        \"height\": str(IMG_SIZE),\n",
    "        \"fill\": \"white\"\n",
    "    })\n",
    "\n",
    "    original_layer = ET.SubElement(svg, \"g\", {\n",
    "        \"id\": \"original_vectors_blue\",\n",
    "        \"stroke\": \"blue\",\n",
    "        \"stroke-width\": \"1\",\n",
    "        \"fill\": \"none\",\n",
    "        \"stroke-linecap\": \"round\"\n",
    "    })\n",
    "\n",
    "    for x0, y0, x1, y1 in original_vectors:\n",
    "        ET.SubElement(original_layer, \"line\", {\n",
    "            \"x1\": str(x0), \"y1\": str(y0),\n",
    "            \"x2\": str(x1), \"y2\": str(y1)\n",
    "        })\n",
    "\n",
    "    predicted_layer = ET.SubElement(svg, \"g\", {\n",
    "        \"id\": \"predicted_vectors_red\",\n",
    "        \"stroke\": \"red\",\n",
    "        \"stroke-width\": \"1\",\n",
    "        \"fill\": \"none\",\n",
